{
  "functions": {
    "source": "functions",
    "runtime": "nodejs20",
    "predeploy": [],
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.local"
    ]
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/email-action",
        "destination": "/auth/action/index.html"
      },
      {
        "source": "/email-verified",
        "destination": "/auth/verified/index.html"
      },
      {
        "source": "/password-reset-done",
        "destination": "/auth/password-reset-done/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
